# ─────────────────────────────────────────────────────────────
# LumeCar — variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos clés.
# Tant que les valeurs restent vides/placeholder, l'app tourne
# en mode démo (données mock, carte stylisée, auth simulée).
# ─────────────────────────────────────────────────────────────

# Supabase — https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connexion Google : AUCUNE variable ici. Le Client ID / Client Secret Google
# se renseignent dans le dashboard Supabase (Authentication → Providers →
# Google) ; le secret ne transite jamais par cette application.
# Redirect URI à déclarer côté Google : https://<projet>.supabase.co/auth/v1/callback
# Voir CLAUDE.md → "Connexion Google (OAuth 2.0)".

# Supabase service role — SERVER ONLY, never expose to the browser.
# Used for privileged admin operations (e.g. full account deletion).
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe — https://dashboard.stripe.com/test/apikeys
# Clé SECRÈTE côté serveur uniquement. sk_test_... = mode test (aucun débit réel).
# Sans clé, la réservation utilise une confirmation simulée.
STRIPE_SECRET_KEY=

# E-mails transactionnels (confirmations de réservation) — Resend.
# https://resend.com → API Keys (re_...). SERVER ONLY.
# EMAIL_FROM doit utiliser un domaine vérifié dans Resend
# (ex. "Nova Compagnie <reservations@novacompagnie.com>"). Sans clé, les e-mails sont
# ignorés et la réservation fonctionne quand même (mode démo).
RESEND_API_KEY=
EMAIL_FROM=
